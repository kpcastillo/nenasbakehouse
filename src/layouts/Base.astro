---
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/caveat/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site.js';
import { categories } from '../data/menu.js';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  /** Extra schema.org objects for this page (Product lists, FAQPage, breadcrumbs). */
  schema?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const bakery = {
  '@type': 'Bakery',
  '@id': `${site.url}/#bakery`,
  name: site.name,
  description: site.description,
  slogan: site.tagline,
  url: site.url,
  email: site.email,
  image: ogImage,
  logo: new URL('/nenas-logo.svg', site.url).href,
  servesCuisine: 'Bakery',
  areaServed: { '@type': 'City', name: 'Las Vegas', containedInPlace: { '@type': 'State', name: 'Nevada' } },
  address: { '@type': 'PostalAddress', addressLocality: 'Las Vegas', addressRegion: 'NV', addressCountry: 'US' },
  sameAs: [site.instagram.url],
  hasMenu: {
    '@type': 'Menu',
    name: 'Nenas Bakehouse menu',
    hasMenuSection: categories.map((c) => ({
      '@type': 'MenuSection',
      name: c.name,
      url: `${site.url}/${c.slug}`,
      hasMenuItem: c.items.map((i) => ({
        '@type': 'MenuItem',
        name: i.name,
        description: i.desc,
        ...(i.offer ? { offers: { '@type': 'Offer', price: i.offer.toFixed(2), priceCurrency: 'USD' } } : {}),
      })),
    })),
  },
  potentialAction: { '@type': 'OrderAction', target: `${site.url}/inquire` },
};
const graph = { '@context': 'https://schema.org', '@graph': [bakery, ...schema] };
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Reveal animations only arm when JS is running; without it, everything is visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f9f1da" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nenas Bakehouse: less sweet, still a treat" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/interactions.js';
    </script>
  </body>
</html>
