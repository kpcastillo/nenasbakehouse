---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Frame from '../components/Frame.astro';
import OrderSteps from '../components/OrderSteps.astro';
import Portrait from '../components/Portrait.astro';
import { categories, bySlug } from '../data/menu.js';
import { site } from '../data/site.js';

const cakes = bySlug('custom-cakes');
const bread = bySlug('sourdough-focaccia');
const treats = ['cookies', 'cinnamon-rolls', 'loaf-cakes'].map(bySlug);
const revealDelay = (i: number) => (i > 0 ? `rv-d${Math.min(i, 3)}` : '');
---
<Base>
  <Rail />
  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" id="hero">
      <div class="grid">
        <div class="hero__type">
          <div class="hero__eyebrow rv">
            <span class="line"></span>
            <span class="util">Home bakery · Las&nbsp;Vegas, NV</span>
          </div>
          <h1>
            <span class="line-mask"><span>Less sweet,</span></span>
            <span class="line-mask"><span>still a <em class="lift">treat</em>.</span></span>
          </h1>
          <p class="hero__sub rv rv-d2">
            Custom cakes, slow-fermented sourdough, cookies and cinnamon rolls,
            made with real ingredients and less sugar so you can taste
            what's underneath.
          </p>
          <div class="hero__actions rv rv-d2">
            <a class="btn" href="/inquire">Start a pre-order <span class="arrow" aria-hidden="true">→</span></a>
            <a class="cta" href="#menu">See the menu</a>
          </div>
          <ul class="hero__meta rv rv-d3">
            <li><strong>Pre-order</strong><span class="util">Baked for your date</span></li>
            <li><strong>Northwest</strong><span class="util">Las Vegas pickup</span></li>
            <li><strong>SNHD</strong><span class="util">Permitted</span></li>
          </ul>
        </div>

        <figure class="hero__plate rv rv-d2">
          <Frame photo="hero" alt="Two round sourdough loaves from Nenas Bakehouse on a wooden board" pattern="dots" label="Made with real ingredients" ratio="4/5" eager
            speed={0.045} sizes="(max-width: 1020px) 90vw, 40vw" />
          <figcaption class="hero__cap">cut it thin,<br />eat it twice <span aria-hidden="true">✦</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ THESIS ============ -->
    <section class="thesis" id="thesis">
      <div class="grid">
        <div class="thesis__label rv"><h2 class="util">The&nbsp;whole&nbsp;idea</h2></div>
        <div class="thesis__body">
          <p class="rv">
            Many recipes use as much sugar as flour. I hold it at about{' '}
            <em>seventy-five percent</em>, so the butter, the fruit and the
            chocolate stop competing with sweetness.
          </p>
          <p class="thesis__note rv rv-d2">
            Go lower and the texture suffers. So this isn't a health claim and
            it isn't a sugar-free cake. It's one measured decision, held across
            everything I bake.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ CAKES ============ -->
    <section class="cakes" id="cakes">
      <span class="anchor" id="menu"></span>
      <div class="sec-head rv">
        <h2>Custom cakes</h2>
        <a class="util sec-link" href="/custom-cakes">All about cakes <span aria-hidden="true">→</span></a>
      </div>
      <p class="sec-intro rv">{cakes.intro}</p>

      {cakes.items.map((cake, i) => (
        <article class="cake rv">
          <div class="cake__idx"><span class="fig" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div>
          <div class="cake__body">
            <h3>{cake.name}</h3>
            <p class="cake__desc">{cake.desc}</p>
          </div>
          <figure class="cake__img">
            <Frame photo={cake.photo} alt={`${cake.name} by Nenas Bakehouse`} label={cake.name}
              pattern={(['stripes', 'dots', 'checker'] as const)[i % 3]} ratio="4/3" />
          </figure>
        </article>
      ))}
      <a class="btn rv" href="/inquire">{cakes.cta} <span class="arrow" aria-hidden="true">→</span></a>
    </section>

    <!-- ============ SAVORY — palette flips via data-family ============ -->
    <section class="savory" id="savory" data-family="savory">
      <div class="sec-head rv">
        <h2>Sourdough &amp; focaccia</h2>
        <a class="util sec-link" href="/sourdough-focaccia">Bread details <span aria-hidden="true">→</span></a>
      </div>
      <div class="loaf">
        <div class="loaf__lede">
          <p class="lede rv">Slow fermented, and baked fresh for your pre-order.</p>
          <p class="loaf__note rv rv-d2">{bread.priceNote}, sold in pre-order drops.</p>
          <a class="btn rv rv-d2" href="/inquire">{bread.cta} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="loaf__list">
          {bread.items.map((item, i) => (
            <li class={`row rv ${revealDelay(Math.floor(i / 2))}`}>
              <span class="row__name">{item.name}</span>
              <span class="row__day">{item.price?.replace(" per loaf", "") ?? "Pre-order"}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ EVERYDAY ============ -->
    <section class="everyday" id="everyday">
      <div class="sec-head rv">
        <h2>Cookies, rolls &amp; loaf cake</h2>
        <span class="util">Small treats, in pre-order drops</span>
      </div>

      <div class="case">
        {treats.map((cat, i) => (
          <article class={`case__item rv ${revealDelay(i)}`}>
            <a href={`/${cat.slug}`} class="case__link" aria-label={cat.name}>
              <Frame photo={cat.photo} alt={`${cat.name} by Nenas Bakehouse`} label={cat.name}
                pattern={cat.pattern} ratio="1/1" />
            </a>
            <h3><a href={`/${cat.slug}`}>{cat.name}</a></h3>
            <ul class="case__list">
              {cat.items.map((item) => <li>{item.name}</li>)}
            </ul>
            {cat.priceNote && <p class="case__price">{cat.priceNote}</p>}
          </article>
        ))}
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="about-teaser" id="about">
      <div class="about-teaser__inner rv">
        <Portrait class="about-teaser__mark" decorative />
        <div>
          <h2>Nena is me.</h2>
          <p>
            It's been my nickname since I was a baby. I bake for you the way I
            bake for my own family, and I won't sell anything I wouldn't serve
            them.
          </p>
          <a class="cta" href="/about">Read my story <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ ORDERING ============ -->
    <section class="order" id="order">
      <div class="grid">
        <div class="order__head">
          <p class="util rv">How ordering works</p>
          <h2 class="rv">Tell me the date, I'll tell you what's possible.</h2>
          <a class="btn rv rv-d2" href="/inquire">Start a pre-order <span class="arrow" aria-hidden="true">→</span></a>
          <p class="lead-note rv rv-d2">
            Custom cakes need {site.leadTimes.custom}. Tiered cakes, {site.leadTimes.tiered}.{' '}
            <a href="/faq">More questions answered</a>.
          </p>
        </div>
        <OrderSteps />
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
