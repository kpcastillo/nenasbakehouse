---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InquiryForm from '../components/InquiryForm.astro';
import OrderSteps from '../components/OrderSteps.astro';
import { site } from '../data/site.js';
---
<Base
  title={`Pre-order & Custom Cake Inquiries | ${site.name}, Las Vegas`}
  description="Send Nenas Bakehouse your date and what you'd like: custom cakes, sourdough, focaccia, cookies or cinnamon rolls. It's an inquiry, not a booking, and nothing is charged."
>
  <Rail />
  <SiteHeader />

  <main id="main">
    <section class="order order--page" id="order">
      <div class="grid">
        <div class="order__head">
          <p class="util rv">Pre-orders &amp; custom cakes</p>
          <h1 class="rv">Tell me the date, I'll tell you what's possible.</h1>
          <a class="cta rv rv-d2" href="/#menu">See the menu first <span class="arrow" aria-hidden="true">→</span></a>
          <p class="lead-note rv rv-d2">
            Custom cakes need {site.leadTimes.custom}. Tiered cakes, {site.leadTimes.tiered}.
          </p>
        </div>
        <OrderSteps />
      </div>

      <InquiryForm />
    </section>
  </main>

  <SiteFooter />
</Base>
