---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site.js';
---
<Base title={`Inquiry received — ${site.name}`} description="Your order inquiry reached Nenas Bakehouse." noindex>
  <Rail />
  <SiteHeader />

  <main id="main" class="ty">
    <div class="ty__inner">
      <p class="util">Order inquiry</p>
      <h1>Got it, thank you.</h1>
      <p>
        Your inquiry is in. I read every message myself and usually reply within
        two days with what's possible for your date, the exact size, and a price.
        Nothing is booked yet.
      </p>
      <p>
        If it's urgent, or you don't hear back, email me directly at{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <a class="btn" href="/">Back to the bakehouse <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </main>

  <SiteFooter />
</Base>
