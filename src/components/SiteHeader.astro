---
import { nav } from '../data/site.js';
import Wordmark from './Wordmark.astro';
---
<header>
  <a href="#main" class="brand" aria-label="Nenas Bakehouse — home">
    <Wordmark class="brand__mark" />
  </a>
  <nav class="nav">
    {nav.map((item) => (
      <a href={item.href} data-nav={item.key}>{item.label}</a>
    ))}
    <a href="/inquire" class="nav-inquire">Inquire</a>
  </nav>
</header>
