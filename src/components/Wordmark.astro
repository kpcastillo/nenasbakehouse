---
// The "Nenas" wordmark on its own. Reuses the artwork from Logo.astro.
interface Props {
  class?: string;
  title?: string;
}
const { class: cls, title = 'Nenas Bakehouse' } = Astro.props;
---
<svg
  class={cls}
  viewBox="173 1300 1648 569"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
  focusable="false"
>
  <use href="#nb-word" />
</svg>
