---
// The headscarf portrait on its own. Reuses the artwork that Logo.astro puts
// in the footer of every page (see the note there). Colour comes from
// `currentColor`; set `--logo-void` to the colour behind it.
interface Props {
  class?: string;
  title?: string;
  decorative?: boolean;
}
const { class: cls, title = 'Nenas Bakehouse', decorative = false } = Astro.props;
---
<svg
  class={cls}
  viewBox="541 134 1104 1241"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : title}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <use href="#nb-face" />
</svg>
